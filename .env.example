# ==============================================================================
# HOTEL CONTRACT MANAGER - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your VPS and configure production values.
# NEVER commit a real .env file containing secrets to version control.
# ==============================================================================

# NODE_ENV: Runtime environment ('production' for live deployment)
NODE_ENV=production

# PORT: Internal network port for the Express application (default: 3000)
PORT=3000

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
# CRITICAL: MUST be generated securely on the VPS terminal and kept strictly confidential.
# Do NOT leave empty in production. Recommended generation command:
#   openssl rand -base64 48
JWT_SECRET=

# JWT_EXPIRES_IN: Lifetime of issued JWT authentication tokens (e.g. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# APP_URL: Canonical public URL where the application is accessible through reverse proxy
APP_URL=https://contracts.youragency.tn

# TRUST_PROXY: Set to 1 when running behind reverse proxy (Cloud Run / Caddy / Nginx)
# Ensures accurate client IP detection for login rate limiting via X-Forwarded-For
TRUST_PROXY=1

# ==============================================================================
# DATABASE CONFIGURATION (GOOGLE CLOUD SQL / POSTGRESQL)
# ==============================================================================
# DATABASE_URL: PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# For Cloud SQL with Cloud SQL Auth Proxy or Unix socket:
#   postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?schema=public
#   or postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# ==============================================================================
# PERSISTENT FILE STORAGE (GOOGLE CLOUD STORAGE)
# ==============================================================================
# GCS_BUCKET_NAME: Google Cloud Storage bucket for uploaded hotel contract files.
# When running on Cloud Run, permissions are automatically handled via the
# service account running the Cloud Run service.
GCS_BUCKET_NAME=
